# Archivo de ejemplo de variables de entorno (copiar como .env y colocar tus llaves reales)
# El archivo .env esta protegido en .gitignore para que ninguna contrasena ni API key se filtre a GitHub

# 1. API de Google Sign-In (OAuth 2.0 Client ID desde Google Cloud Console)
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com

# 2. Pasarela de Pago Culqi (Modo Integracion / Pruebas Sandbox)
CULQI_PUBLIC_KEY=pk_test_coloca_aqui_tu_llave_publica
CULQI_SECRET_KEY=sk_test_coloca_aqui_tu_llave_secreta

# 3. Correo Gmail para enviar los comprobantes de cobro (usa Contrasena de Aplicacion de 16 letras de Google)
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=xxxx_xxxx_xxxx_xxxx
